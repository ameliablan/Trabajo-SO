void Cmd_fin(char *arg[])
{
    (void)arg;
    PathClear();                 /* libera la memoria del path */
    exit(0);
}

void Cmd_authors(char *arg[])
{
    if (arg[0] == NULL) {
        printf("%s : %s\n", AUTOR1_NOMBRE, AUTOR1_LOGIN);
        printf("%s : %s\n", AUTOR2_NOMBRE, AUTOR2_LOGIN);
    } else if (!strcmp(arg[0], "-l")) {
        printf("%s\n%s\n", AUTOR1_LOGIN, AUTOR2_LOGIN);
    } else if (!strcmp(arg[0], "-n")) {
        printf("%s\n%s\n", AUTOR1_NOMBRE, AUTOR2_NOMBRE);
