{
    (void)arg;
    MostrarDirActual();
}

void Cmd_open(char *arg[])
{
    int i, df, flags = 0, acceso = O_RDONLY;
    char modos[64] = "";
    size_t len = 0;

    if (arg[0] == NULL) {                 /* sin argumentos: lista */
        printFList(&openFiles);
        return;
    }

    for (i = 1; arg[i] != NULL; i++) {
        if (!strcmp(arg[i], "cr")) flags |= O_CREAT;
        else if (!strcmp(arg[i], "ex")) flags |= O_EXCL;
        else if (!strcmp(arg[i], "ap")) flags |= O_APPEND;
        else if (!strcmp(arg[i], "tr")) flags |= O_TRUNC;
        else if (!strcmp(arg[i], "ro")) acceso = O_RDONLY;
        else if (!strcmp(arg[i], "wo")) acceso = O_WRONLY;
        else if (!strcmp(arg[i], "rw")) acceso = O_RDWR;
        else {
            printf("Modo no valido: %s\n", arg[i]);
            return;
        }
        if (len + 4 < sizeof(modos))      /* nunca se desborda modos[] */
            len += snprintf(modos + len, sizeof(modos) - len, "%s%s",
                            len ? " " : "", arg[i]);
    }
    if (len == 0)
        snprintf(modos, sizeof(modos), "ro");

    if ((df = open(arg[0], flags | acceso, 0666)) == -1) {
        perror("Imposible abrir fichero");
        return;
    }
    insertFList(&openFiles, df, arg[0], modos);
}

void Cmd_close(char *arg[])
{
    char *fin;
    long df;

    if (arg[0] == NULL) {                 /* sin argumentos: lista */
        printFList(&openFiles);
        return;
    }

    df = strtol(arg[0], &fin, 10);
    if (fin == arg[0] || *fin != '\0' || df < 0 || df > INT_MAX) {
        printf("Descriptor no valido: %s\n", arg[0]);
        return;
    }
    if (getFName(&openFiles, (int)df) == NULL) {
        printf("El descriptor %ld no esta en la lista de ficheros abiertos\n", df);
        return;
    }
    if (close((int)df) == -1) {
        perror("Imposible cerrar descriptor");
        return;
    }
    deleteFList(&openFiles, (int)df);
}

void Cmd_listopen(char *arg[])
{
    (void)arg;
    printFList(&openFiles);
}

void Cmd_exec(char *arg[])
{
    char *ruta;

    if (arg[0] == NULL) {
        printf("Uso: exec programa [argumentos]\n");
        return;
    }
    if ((ruta = Ejecutable(arg[0])) == NULL) {
        errno = ENOENT;
        perror("Imposible ejecutar");
        return;
    }
    if (execv(ruta, arg) == -1)
        perror("Imposible ejecutar");
}

void Cmd_splano(char *arg[])
{
    Proceso(arg, 1);
}

void Cmd_pplano(char *arg[])
{
    Proceso(arg, 0);
}

void Cmd_where(char *arg[])
{
    char *ruta;

    if (arg[0] == NULL)
        printf("Uso: where ejecutable. Indica donde esta ejecutable en el path\n");
    else if ((ruta = Ejecutable(arg[0])) == NULL)
        printf("%s no esta en el path\n", arg[0]);
    else
        printf("%s\n", ruta);
}

void Cmd_importpath(char *arg[])
{
    (void)arg;
    if (PathAddPath() == -1)
        perror("Imposible importar el path");
}

void Cmd_path(char *arg[])
{
    if (arg[0] == NULL)
        PathPrint();
    else if (!strcmp(arg[0], "-add"))
        AniadirAlPath(arg[1]);
    else if (!strcmp(arg[0], "-del"))
        EliminarDelPath(arg[1]);
    else if (!strcmp(arg[0], "-show"))
        PathPrint();
    else if (!strcmp(arg[0], "-clear"))
        PathClear();
    else if (!strcmp(arg[0], "-import"))
        Cmd_importpath(NULL);
    else
        printf("Opciones validas: -add|-del|-show|-clear|-import\n");
}

/***************************** SHELL ********************************/

void DecidirComando(char *tr[])
{
    int i;

    if (tr[0] == NULL)
        return;
    for (i = 0; i < n_commands; i++)
        if (!strcmp(commands[i].cmd_name, tr[0])) {
            commands[i].handler(tr + 1);   /* sin el nombre del comando */
            return;
        }
    Cmd_pplano(tr);   /* si no es un comando, es un ejecutable externo */
}

/* Trocea la linea en palabras. Devuelve cuantas hay (nunca mas de max-1)
   y deja trozos[] terminado en NULL. */
int TrocearCadena(char *cadena, char *trozos[], int max)
{
    int i = 0;
    char *t = strtok(cadena, " \n\t\r");

    while (t != NULL && i < max - 1) {
        trozos[i++] = t;
        t = strtok(NULL, " \n\t\r");
    }
    trozos[i] = NULL;
    return i;
}

void ProcesarEntrada(char *entrada)
{
    char *tr[MAXTROZOS];

    if (TrocearCadena(entrada, tr, MAXTROZOS) == 0)   /* linea vacia */
        return;
    DecidirComando(tr);
}

int main(int argc, char *argv[])
{
    char entrada[MAXENTRADA];
    size_t n;
    int c;

    createFList(&openFiles);

    if (argc < 2)
        printf("Ejecutando con path vacio: %s -p para importar el path\n", argv[0]);
    else if (!strcmp(argv[1], "-p"))
        Cmd_importpath(NULL);

    while (1) {
        printf("-> ");
        fflush(stdout);

        if (fgets(entrada, MAXENTRADA, stdin) == NULL) {   /* Ctrl-D: fin */
            printf("\n");
            Cmd_fin(NULL);
        }

        n = strlen(entrada);
        if (n == MAXENTRADA - 1 && entrada[n - 1] != '\n') {
            /* linea demasiado larga: descartar lo que queda de ella */
            while ((c = getchar()) != '\n' && c != EOF);
            printf("Linea demasiado larga\n");
            continue;
        }
        ProcesarEntrada(entrada);
    }
}
