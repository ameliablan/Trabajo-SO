void Cmd_pid(char *arg[])
{
    if (arg[0] == NULL)
        printf("El pid del proceso es %d\n", (int)getpid());
    else if (!strcmp(arg[0], "-p"))
        printf("El pid del proceso padre es %d\n", (int)getppid());
    else
        printf("Uso: pid [-p]\n");
}

void Cmd_date(char *arg[])
{
    char hora[16], fecha[16];
    time_t t = time(NULL);
    struct tm *tm = localtime(&t);

    if (tm == NULL) {
        perror("Imposible obtener la fecha");
        return;
    }
    strftime(hora, sizeof(hora), "%H:%M:%S", tm);
    strftime(fecha, sizeof(fecha), "%d/%m/%Y", tm);

    if (arg[0] == NULL)
        printf("%s\n%s\n", hora, fecha);
    else if (!strcmp(arg[0], "-d"))
        printf("%s\n", fecha);
    else if (!strcmp(arg[0], "-t"))
        printf("%s\n", hora);
    else
        printf("Uso: date [-d|-t]\n");
}

void Cmd_sysinfo(char *arg[]) {
    struct utsname info;
    if (uname(&info) == -1) {
        perror("Imposible obtener sysinfo");
        return;
    }
    printf("Sistema: %s\n", info.sysname);
    printf("Nodename: %s\n", info.nodename);
    printf("Release: %s\n", info.release);
    printf("Version: %s\n", info.version);
    printf("Machine: %s\n", info.machine);
}

